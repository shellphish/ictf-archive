#! /bin/bash
#
# ices

# Source function library.
. /etc/init.d/functions

RETVAL=0

# See how we were called.
  
prog="ices"
ICES_OPTIONS="-c /usr/local/etc/ices.conf -B"

start() {
	echo -n $"Starting $prog: "
	daemon /usr/local/bin/ices $ICES_OPTIONS 
	RETVAL=$?
	echo "retval " $RETVAL
	echo
	[ $RETVAL -eq 0 ] && touch /var/lock/subsys/ices
	return 0
}

stop() {
	echo -n $"Stopping $prog: "
	killproc ices
	RETVAL=$?
	echo
	[ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/ices
	return 0
}	

rhstatus() {
	status ices
}	

restart() {
  	stop
	start
}	

reload() {
	echo -n $"Reloading ices daemon configuration: "
	killproc ices -HUP
	retval=$?
	echo
	return $RETVAL
}	

case "$1" in
  start)
  	start
	;;
  stop)
  	stop
	;;
  restart)
  	restart
	;;
  reload)
  	reload
	;;
  status)
  	rhstatus
	;;
  condrestart)
  	[ -f /var/lock/subsys/ices ] && restart || :
	;;
  *)
	echo $"Usage: $0 {start|stop|status|reload|restart|condrestart}"
	exit 1
esac

exit $?
