#! /bin/bash
#
# icecast

# Source function library.
. /etc/init.d/functions

RETVAL=0

# See how we were called.
  
prog="icecast"
ICECAST_OPTIONS="-c /usr/local/etc/icecast.xml"

start() {
	echo -n $"Starting $prog: "
	daemon /usr/local/bin/icecast $ICECAST_OPTIONS &
	RETVAL=$?
	echo
	[ $RETVAL -eq 0 ] && touch /var/lock/subsys/icecast
	return $RETVAL
}

stop() {
	echo -n $"Stopping $prog: "
	killproc icecast
	RETVAL=$?
	echo
	[ $RETVAL -eq 0 ] && rm -f /var/lock/subsys/icecast
	return $RETVAL
}	

rhstatus() {
	status icecast
}	

restart() {
  	stop
	start
}	

reload() {
	echo -n $"Reloading icecast daemon configuration: "
	killproc icecast -HUP
	retval=$?
	echo
	return $RETVAL
}	

case "$1" in
  start)
  	start
	;;
  stop)
  	stop
	;;
  restart)
  	restart
	;;
  reload)
  	reload
	;;
  status)
  	rhstatus
	;;
  condrestart)
  	[ -f /var/lock/subsys/icecast ] && restart || :
	;;
  *)
	echo $"Usage: $0 {start|stop|status|reload|restart|condrestart}"
	exit 1
esac

exit $?
