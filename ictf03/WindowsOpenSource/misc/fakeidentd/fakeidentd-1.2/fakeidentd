#!/bin/bash

check_status()
{
	if [ $? = 0 ]
	then
		echo "OK"
	else
		echo "FAILED"
	fi
}

case "$1" in
	start)
	 echo -n "Starting fakeidentd...			"
	 start-stop-daemon -S -q -o -x /sbin/identd -- `cat /etc/identuser` 
	 check_status
	;;
	
	stop)
	 echo -n "Stopping FAKEIDENTD...		"
	 start-stop-daemon -K -q -o -x /sbin/identd
	 check_status
	;;

	*)
	 echo "Usage: $0 {start|stop}"
	 exit 1
	;;
esac
