                             "10" border="0"></td>
                      </tr>
                    </tbody>
                  </table><!--FEATURE STORY END HERE-->
                  <!--FEATURE STORY START HERE-->

                  <table>
                    <tbody>
                      <tr>
                        <td valign="top"><a href=
                        "http://www.microsoft.com/presspass/features/2003/nov03/11-17tabletpc.asp">
                        <img src="index_files/tabletpc.jpg"
                             border="0" alt=
                             "Q&amp;A: Inside the Next Version of the Tablet PC Operating System"
                             width="122" height="99"></a></td>

                        <td valign="top"><img src=
                        "index_files/1ptrans.gif" width="1"
                             height="3" border="0"><br>
