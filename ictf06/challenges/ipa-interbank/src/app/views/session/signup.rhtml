<%= error_messages_for :user %>
<% form_for :user do |f| -%>
<table>
<tr><td><label for="login">Login</label></td>
<td><label for="email">Email</label></td></tr>
<tr><td><%= f.text_field :login %></td>
<td><%= f.text_field :email %></td></tr>
<tr><td><label for="password">Password</label></td>
<td><label for="password_confirmation">Confirm Password</label></td></tr>
<tr><td><%= f.password_field :password %></td>
<td><%= f.password_field :password_confirmation %></td></td>
</table>

<p><label for="image_link">Image</label><br/>
<table>
    <tr>
        <td><%= image_tag("thumb_1.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_2.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_3.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_4.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_5.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_6.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_7.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_8.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_9.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_10.jpg", :size => "45x45", :border => 0) %></td>
        <td><%= image_tag("thumb_11.jpg", :size => "45x45", :border => 0) %></td>
    </tr>
    <tr>
        <td><%= f.radio_button("image_link", "thumb_1.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_2.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_3.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_4.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_5.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_6.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_7.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_8.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_9.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_10.jpg") %></td>
        <td><%= f.radio_button("image_link", "thumb_11.jpg") %></td>
    </tr>
</table>


<p><label for="description">Tell us about yoursefl</label><br/>
<%= f.text_area :description, :cols => 80, :rows => 3 %></p>

<p><%= submit_tag 'Sign up' %></p>
<% end -%>
