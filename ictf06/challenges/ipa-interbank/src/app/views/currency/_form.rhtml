<%= error_messages_for 'currency' %>

<!--[form:currency]-->
<p><label for="currency_symbol">Symbol</label><br/>
<%= text_field 'currency', 'symbol'  %></p>

<p><label for="currency_name">Name</label><br/>
<%= text_field 'currency', 'name'  %></p>

<p><label for="currency_description">Description</label><br/>
<%= text_field 'currency', 'description'  %></p>
