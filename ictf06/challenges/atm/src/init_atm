#! /bin/sh
set -e

DAEMON=/home/atm/atm.py

test -x $DAEMON || exit 0

. /lib/lsb/init-functions
. /etc/default/rcS

case "$1" in
  start)	
	    log_begin_msg "Starting ATM service"
	    if [ -s /var/run/atm.pid ] && kill -0 $(cat /var/run/atm.pid) >/dev/null 2>&1; then
		exit 0
	    fi
            cd /home/atm
            start-stop-daemon --start --background \
                --pidfile /var/run/atm.pid --make-pidfile \
                --exec /home/atm/atm.py \
		-c atm:atm \
                -- --no-detach --daemon
            log_end_msg $?
	;;
  stop)
        log_begin_msg "Stopping ATM service"
	ES=$?
	start-stop-daemon --stop --quiet --oknodo --pidfile /var/run/atm.pid
	rm -f /var/run/atm.pid
        log_end_msg $ES
	;;

  *)
	log_success_msg "Usage: /etc/init.d/atm {start|stop}"
	exit 1
esac

exit 0
