# LiteLLM proxy configuration
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=<your_openai_api_key>

# Separate keys for challenge vs team (recommended)
CHALLENGE_LITELLM_API_KEY=challenge-specific-local-key
CHALLENGE_LITELLM_MODEL=gpt-4o-mini

TEAM_LITELLM_API_KEY=team-and-challenge-specific-local-key
TEAM_LITELLM_MODEL=gpt-4o-mini

# LiteLLM admin key
LITELLM_MASTER_KEY=local-admin-key

# LangFuse observability (optional)
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Challenge flag (do not change in production)
FLAG_CHALLENGE=ictf{r3v3rs3_3ng1n33r1ng_m4st3r_2025}
