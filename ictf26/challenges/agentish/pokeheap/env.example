# Team-specific flag (set per team by organizers)
FLAG=ictf{placeholder}

# OpenAI — used by flag_reveal.py when win() is triggered
OPENAI_API_KEY=sk-...

# Langfuse — flag appears in the trace log
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# LiteLLM proxy (organizer-provided in production)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=gpt-4o
TEAM_LITELLM_MODEL=gpt-4o
TEAM_LITELLM_API_KEY=...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
