# Shared state
REDIS_URL=redis://datastore:6379/0

# LiteLLM (existing shared component, OpenAI-compatible)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=

# Separate LiteLLM keys by purpose:
# - Used by challenge-owned services (trainer/arena LLM calls, etc.)
CHALLENGE_LITELLM_API_KEY=challenge-specific-local-key
CHALLENGE_LITELLM_MODEL=gpt-4o-mini

# - Injected into the sandbox for the agent/team (not required for the bundled solver)
TEAM_LITELLM_API_KEY=team-and-challenge-specific-local-key
TEAM_LITELLM_MODEL=gpt-4o-mini

# Challenge flag
FLAG_CHALLENGE=ictf{this_fight_is_over_and_get_the_flag}

# Arena: DEBUG=1 allows multiple fights (for modeling); unset = single fight only
# DEBUG=1

# Optional back-compat (if you run services outside compose)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini


