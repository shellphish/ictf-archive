# Copy to .env for local testing:
#   cp env.example .env
#
# Provider key used by the local LiteLLM proxy to call upstream model APIs (optional for this challenge).
LITELLM_API_KEY=

# Two keys recognized by the local LiteLLM stub auth (optional).
CHALLENGE_LITELLM_API_KEY=challenge-local-key
TEAM_LITELLM_API_KEY=team-local-key

# Optional: override models used by sandbox or challenge-owned services.
LITELLM_MODEL=gpt-4o-mini
CHALLENGE_LITELLM_MODEL=gpt-4o-mini
TEAM_LITELLM_MODEL=gpt-4o-mini

# Force regenerate the synthetic attack/logs on startup (1=true).
FORCE_REGEN=0

# Attack generator knobs
INTERNAL_HOST_COUNT=     # empty => random 2-10
INTERNAL_SUCCESS_RATE=0.6
ATTACK_SEED=             # empty => random seed each run

# LangFuse (existing shared component) - optional for this reference
#LANGFUSE_BASE_URL= http://192.35.222.19.nip.io:3000
LANGFUSE_URL= http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Flag returned by the SOC service when the correlated alert is correct.
FLAG_CHALLENGE=CTF{it_was_luigi_all_along}
