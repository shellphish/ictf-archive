# Copy to .env for local testing:
#   cp example.env .env
#
# Provider key used by the local LiteLLM proxy to call upstream model APIs.
LITELLM_API_KEY=

# Two keys recognized by the local LiteLLM stub auth.
CHALLENGE_LITELLM_API_KEY=challenge-local-key
TEAM_LITELLM_API_KEY=team-local-key

# Optional: override models used by sandbox or challenge-owned services.
LITELLM_MODEL=gpt-4o-mini
CHALLENGE_LITELLM_MODEL=gpt-4o-mini
TEAM_LITELLM_MODEL=gpt-4o-mini

# Flag returned if the challenge is solved
FLAG=iCTF{THIS_IS_A_TEST_FLAG}

