# Initialization
AC_INIT(libzocket, 1.0, vigna@cs.ucsb.edu)
AM_INIT_AUTOMAKE(libzocket, 1.0)

# Check for programs
AC_PROG_CC
AC_PROG_INSTALL
AC_PROG_RANLIB

# Check for bar lib
