#! /usr/bin/python
import cgi, sys

def find(filename, cc, candidate):
	f = None
	try:
		f = open(filename,'r')
		last  = None 
		lines = f.readlines()
		for line in lines:
			l = line.split()
			if l[1]==cc:
				last = l
		if last != None:
			print "<p>Your last donation was:</p><p>Candidate: %s</p><p>CC Number: %s</p><p>Amount: %s</p>"%(last[0],last[1],last[2])
	except:
		print "<p>Sorry. Due to a server error we are not able to process your request.</p>"
		if f != None: 
			f.close()

def create_file(filename, cc):
	f = None
	out = open("../%s.php"%cc,'w')
	out.write('<html>\n <head>\n  <title>Donation Summary</title>\n </head>\n <body bgcolor="#6699ff" textcolor=white>\n')
	try:
		f = open(filename,'r')
		last  = None 
		lines = f.readlines()
		for line in lines:
			l = line.split(' ',4)
			if l[1]==cc:
				out.write("  <p>%s -- %s (%s)</p>\n"%(l[0],l[2],l[4]))
	except:
		print "<p>Sorry. Due to a server error we are not able to process your request.</p>"
		if f != None: 
			f.close()
	out.write(' </body>\n</html>\n')
	out.close()
	
				
def add(filename, cc, candidate, value, comment):
	f = None
	
	try:
		f = open(filename,'a')
		f.write("%s %s %d -- %s \r\n"%(candidate, cc, value, comment))
	except:
		if f != None:
			f.close()

print "Content-Type: text/html\n"
print
#print "<html><head></head><body><h1>ciao</h1></body></html>"

form = cgi.FieldStorage()
candidate = form["candidate"].value
ccard     = form["cc"].value
s_amount  = form["amount"].value
comment   = form["comment"].value
filename  = "donations.bin"
amount    = 0

try:
	amount = int(s_amount)
except:
	print "<h1>Value Error!!</h1>The donation must be an integer number..."
	sys.exit()

#print "candidate = %s<br>"%candidate
#print "amount = %d<br>"%amount
#print "credita card = %s<br>"%ccard
	
if len(ccard) < 5:
	print "<h1>Credit Card Error<h1>What are you thinking to do ???<br>Are you trying to use a fake number ??"
	sys.exit()

find(filename, ccard, candidate)
add(filename, ccard, candidate, amount, comment)
create_file(filename, ccard)

print "<b>Thank you very much for your donation</b>"
print '<p>Click <a href="../%s.php">here</a> to review your donations<p>'%ccard