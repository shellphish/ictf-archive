@InProceedings{	  picco97:expressing,
  author	= {G.P. Picco and G.-C. Roman and P.J. McCann},
  title		= {{Expressing Code Mobility in Mobile UNITY}},
  year		= 1997,
  booktitle	= {Proc. of the 6$^{th}$ European Software Engineering Conf.
		  held jointly with the 5$^{th}$ ACM SIGSOFT Symp. on the
		  Foundations of Software Engineering (ESEC/FSE '97)},
  editor	= {M. Jazayeri and H. Schauer},
  address	= {Zurich, Switzerland},
  month		= sep,
  publisher	= {Springer},
  series	= {LNCS},
  volume	= 1301,
  pages		= {500--518},
  abstract	= {Advancements in network technology have led to the
		  emergence of new computing paradigms that challenge
		  established programming practices by employing weak forms
		  of consistency and dynamic forms of binding. Code mobility,
		  for instance, allows for invocation-time binding between a
		  code fragment and the location where it executes.
		  Similarly, mobile computing allows hosts (and the software
		  they execute) to alter their physical location. Despite
		  apparent similarities, the two paradigms are distinct in
		  their treatment of location and movement. This paper seeks
		  to uncover a common foundation for the two paradigms by
		  exploring the manner in which stereotypical forms of code
		  mobility can be expressed in a programming notation
		  developed for mobile computing. Several solutions to a
		  distributed simulation problem are used to illustrate the
		  modeling strategy for programs that employ code mobility.}
}

