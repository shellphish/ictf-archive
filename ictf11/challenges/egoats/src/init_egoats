#! /bin/sh
# /etc/init.d/egoats
#
### BEGIN INIT INFO
# Provides:          egoats
# Required-Start:    $all
# Required-Stop:     
# Default-Start:     2 3 4 5 
# Default-Stop:      0 1 6
# Short-Description: Starts the program at boot time
# Description:       Enable service provided by the program
### END INIT INFO

DAEMON=/home/egoats/launch
PROGHOME=/home/egoats/
PROGNAME=egoats
PROGUSER=egoats
PIDFILE=/var/run/egoats.pid

test -x $DAEMON || exit 0

case "$1" in
  start)
    echo "Starting $PROGNAME..."
    start-stop-daemon --start -b -m -d $PROGHOME -c $PROGUSER --pidfile $PIDFILE --exec $DAEMON
    if [ $? -ne 0 ]; then echo "Error: failed starting $PROGNAME (possibly program already running)"; exit 0; fi
    echo "... started!"
    ;;
  stop)
    echo "Stopping $PROGNAME..."
    if [ -x $PIDFILE ]
        then 
        rm $PIDFILE
    fi
    killall -9 -u egoats 
    echo "... stopped!"
    ;;
  force-reload|restart)
    echo "Restarting $PROGNAME..."
    sh $0 stop
    sh $0 start
    ;;
  *)
    echo "Usage: $0 [ start | stop | restart ]"
    exit 1
    ;;
esac

exit 0
