iptables -t nat -A PREROUTING -i eth0 -p tcp -d 128.111.48.48 --dport 34 -j DNAT --to 192.168.1.50:22
iptables -t nat -A PREROUTING -i eth0 -p tcp -d 128.111.48.48 --dport 35 -j DNAT --to 192.168.1.60:22
iptables -t nat -A PREROUTING -i eth0 -p tcp -d 128.111.48.48 --dport 36 -j DNAT --to 192.168.1.70:22
