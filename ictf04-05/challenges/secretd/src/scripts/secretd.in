#! /bin/sh

test -x @bindir@/secretd || exit 0

case "$1" in
  start)
    echo -n "Starting secret service: "
    start-stop-daemon --start --quiet -u secretd -g secretd -b --exec @bindir@/secretd
    echo "secretd."
    ;;

  stop)
    echo -n "Stopping secret service: "
    start-stop-daemon --stop --quiet --oknodo --exec @bindir@/secretd
    echo "secretd."
    ;;

  *)
    echo "usage: /etc/init.d/secretd {start|stop}"
    exit 1
esac

exit 0

