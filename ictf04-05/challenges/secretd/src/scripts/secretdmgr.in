#! /bin/bash
#: secretd wrapper

# XXX: Sometimes this stupid daemon corrupts the secret database,
#      so in that case just remove it. It's not like the users
#      really count or anything...

# Settings
secretd="@bindir@/secretd"
log="/tmp/secretd.log"

trap exit SIGINT
trap exit SIGKILL

while true; do
  $secretd >>$log 2>&1
done

