#!/usr/bin/env python3

import json
import sys
import random
import pickle
import nclib
import compiler

tweets = pickle.load(open('tweets.p', 'rb'))

def set_flag(ip, port, flag):
    nc = nclib.Netcat(ip, port)
    nc.recvuntil('> ')
    nc.sendline('3')

    tweet = random.choice(tweets)
    while '\n\n' in tweet:
        tweet = tweet.replace('\n\n', '\n')
    tweet = tweet.strip()
    nc.send(tweet + '\n\n\n')

    nc.recvuntil('associated with tweet:\n')
    nc.sendline(flag)

    nc.recvuntil("Share it with friends! ")
    ident = nc.recvline().strip().decode()
    nc.recvuntil("Don't lose it! ")
    token = nc.recvline().strip().decode()
    nc.sendline('')
    nc.recvuntil('Good bye')
    nc.close()

    return {
        'error': 0,
        'error_msg': "",
        'payload': {
            'flag_id': ident,
            'secret_token': token,
        }
    }


if __name__ == "__main__":
    print(json.dumps(set_flag(sys.argv[1], int(sys.argv[2]), sys.argv[3])))
