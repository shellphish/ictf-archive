F = fn(x, y, z) { return ((x) & (y)) | (MASK(~x) & (z)); };
G = fn(x, y, z) { return ((x) & (z)) | ((y) & MASK(~z)); };
H = fn(x, y, z) { return (x) ^ (y) ^ (z); };
I = fn(x, y, z) { return (y) ^ ((x) | MASK(~z)); };

ROTATE_LEFT = fn(x, n) { return (MASK(x << n) | MASK(MASK(x) >> (32 - n))); };
MASK = fn(x) { return x & 0xffffffff; };

MK_TRANSFORM = fn(func) { return fn(a, b, c, d, x, s, ac) { r1 = MASK(a + func(b, c, d) + x + ac); r2 = ROTATE_LEFT(r1, s); r3 = MASK(r2 + b); return r3; }; };
FF = MK_TRANSFORM(F);
GG = MK_TRANSFORM(G);
HH = MK_TRANSFORM(H);
II = MK_TRANSFORM(I);

a = 0x67452301;
b = 0xefcdab89;
c = 0x98badcfe;
d = 0x10325476;
a = FF (a, b, c, d, 1, 7, 0xd76aa478);
d = GG (d, a, b, c, 2, 9, 0xc040b340);
c = HH (c, d, a, b, 3, 16, 0x6d9d6122);
b = II (b, c, d, a, 4, 21, 0xfc93a039);
result = a ^ b ^ c ^ d;
log(result);
if result == 363803787 { log("GOOD_STRING"); } else { log("BAD_STRING"); }
