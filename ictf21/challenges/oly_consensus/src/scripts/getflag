#!/usr/bin/env python3

import json
import sys
import random
import pickle
import nclib
import compiler

getflag_template = open('getflag.oly').read()

def get_flag(ip, port, flag_id, token):
    getflag_templated = getflag_template.replace("FLAG_ID", flag_id).replace("SECRET_TOKEN", token)
    getflag = compiler.oly_compile(getflag_templated)

    nc = nclib.Netcat(ip, port)
    nc.recvuntil('> ')
    nc.sendline('1')
    nc.sendline(getflag.hex())
    nc.recvuntil('> ')
    nc.sendline('2')
    nc.recvuntil('return to menu\n')
    flag = nc.recvline().strip().decode()
    nc.sendline('')
    nc.sendline('')
    nc.recvuntil('Good bye')
    nc.close()

    return {
        'error': 0,
        'error_msg': "",
        'payload': {
            'flag': flag
        }
    }

if __name__ == "__main__":
    print(json.dumps(get_flag(sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4])))
