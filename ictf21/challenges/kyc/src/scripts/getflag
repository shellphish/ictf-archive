#!/usr/bin/env python3
import json
import sys
import telnetlib
import requests
from common import *
import time

def get_flag(ip, port, flag_id, token):
    username = flag_id
    password = token

    session  = requests.Session()
    login(session, ip, port, username, password)
    
    pdf  = idcard(session, ip, port)
    flag = pdf_to_string(pdf)
        
    return {
        'error': 0,
        'error_msg': "",
        'payload': {
            'flag': flag.strip()
        }
    }

if __name__ == "__main__":
    print(json.dumps(get_flag(sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4])))
