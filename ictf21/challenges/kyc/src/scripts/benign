#!/usr/bin/env python3
import os
import json
import sys
import glob
import requests
from common import *

def get_fake_id_jpg():
    card = random.choice(glob.glob("fakeids/jpg/*"))
    with open(card, 'rb') as f:
        return os.path.basename(card), f.read()

def get_fake_id_svg():
    card = random.choice(glob.glob("fakeids/svg/*"))
    with open(card, 'rb') as f:
        return os.path.basename(card), f.read()
    
def rick(ip, port):
    username = gen_username()
    password = gen_password()

    session  = requests.Session()    
    register(session, ip, port, username, password)
    login(session, ip, port, username, password)

    card, content = get_fake_id_jpg()
    kyc(session, ip, port, card, content)
 
def svg(ip, port):
    username = gen_username()
    password = gen_password()

    session  = requests.Session()    
    register(session, ip, port, username, password)
    login(session, ip, port, username, password)

    card, content = get_fake_id_svg()
    kyc(session, ip, port, card, content)
   
def benign(ip, port):
    rick(ip, port)
    svg(ip, port)
    
    return {'error': 0, 'error_msg': "", 'payload': {}}


if __name__ == "__main__":
    print(json.dumps(benign(sys.argv[1], int(sys.argv[2]))))

