#!/usr/bin/env python

import json
from pwn import *

context.timeout = 3
context.log_level = "error"

def gen_str(cnt):
    return ''.join(random.choice(string.ascii_uppercase + string.ascii_lowercase) for _ in range(cnt))

def login(r, save, passwd):
    r.sendlineafter(b"Are you a new player? (y/n)", b'n')
    r.sendlineafter(b'Where is your save file?', save)
    r.sendlineafter(b"Password?", passwd)
    return save

def get_flag(ip, port, flag_id, token):
    r = remote(ip, port)
    save_file = login(r, flag_id.encode(), token.encode())
    r.sendlineafter(b'Save the game and quit.', b'3')
    r.recvuntil(b'something in the past:\n')
    flag = r.recvline().strip().decode()
    return {
            'error': 0,
            'error_msg': "",
            'payload': {
                'flag': flag
                }
            }

if __name__ == "__main__":
    print(json.dumps(get_flag(sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4])))
