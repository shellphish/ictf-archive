#!/usr/bin/env python

import json
import random
from pwn import *

context.timeout = 3
context.log_level = "error"

def gen_str(cnt):
    return ''.join(random.choice(string.ascii_uppercase + string.ascii_lowercase) for _ in range(cnt))

SAVE_FILE = None
PASSWD = gen_str(32).encode()

def signup(r):
    out = r.sendlineafter(b"Are you a new player? (y/n)", b'y')
    assert out
    out = r.sendlineafter(b"Password?", PASSWD)
    assert out
    out = r.recvuntil(b"file is at: ")
    assert out
    return r.recvline().strip()

def login(r, save_file):
    out = r.sendlineafter(b"Are you a new player? (y/n)", b'n')
    assert out
    out = r.sendlineafter(b'Where is your save file?', save_file)
    assert out
    out = r.sendlineafter(b"Password?\n", PASSWD)
    assert out
    line = r.recvline()
    assert b'enjoy' in line

def buy_stock(r, stock_id, share):
    out = r.sendlineafter(b'Save the game and quit.', b'6')
    assert out
    out = r.sendlineafter(b'4. ForRiver', str(stock_id).encode())
    assert out
    out = r.sendlineafter(b'2. Sell', b'1')
    assert out
    out = r.sendlineafter(b'How many shares?', str(share).encode())
    assert out

def sell_stock(r, stock_id, share):
    out = r.sendlineafter(b'Save the game and quit.', b'6')
    assert out
    out = r.sendlineafter(b'4. ForRiver', str(stock_id).encode())
    assert out
    out = r.sendlineafter(b'2. Sell', b'2')
    assert out
    out = r.sendlineafter(b'How many shares?', str(share).encode())
    assert out

def send_share(r, share):
    out = r.sendlineafter(b'Save the game and quit.', b'7')
    assert out
    out = r.sendlineafter(b'do you want to send?\n', str(share).encode())
    assert out
    out = r.recvline()
    assert out
    line = r.recvline()
    assert b'sorry' in line

def check_event(r):
    out = r.recvuntil(b'================================\n')
    assert out
    line = r.recvline()
    # print([line])
    if line.startswith(b'At the age'):
        return 0
    elif line.startswith(b'A horrible car accident happened'):
        return 1
    elif line.startswith(b'Hold the line and do not sell'):
        return 2
    elif line.startswith(b'Your wife is sick, she somehow is'):
        return 3
    elif line.startswith(b"Yo, I'm kylebot"):
        return 4
    elif line.startswith(b'Trading meme stocks for the whole '):
        return 5
    else:
        print([line])
        raise

def check_new_user(ip, port):
    global SAVE_FILE
    r = remote(ip, port)
    SAVE_FILE = signup(r)
    r.close()

def check_events(ip, port):
    r = remote(ip, port)
    signup(r)
    a = [False]*6
    for i in range(101):
        idx = check_event(r)
        a[idx] = True
        if idx == 0:
            r.sendlineafter(b'127. Save the game and quit.\n', b'1')
        elif idx == 4:
            r.sendlineafter(b'What do you think? (y/n)', b'n')
    assert all(x is True for x in a)
    r.close()

def check_minor_actions(ip, port):
    r = remote(ip, port)
    save = signup(r)

    # check pass_time
    out = r.sendlineafter(b'Save the game and quit.\n', b'1')
    assert out
    line = r.recvline()
    assert b'You lie down' in line

    # check write_diary
    out = r.sendlineafter(b'Save the game and quit.\n', b'2')
    assert out
    diary = gen_str(32).encode()
    out = r.sendlineafter(b'What do you feel like to write today?\n', diary)
    assert out

    # check read_diary
    out = r.sendlineafter(b'Save the game and quit.\n', b'3')
    assert out
    line = r.recvline()
    assert b'You wrote' in line
    line = r.recvline()
    assert diary in line

    # check carnival
    out = r.sendlineafter(b'Save the game and quit.\n', b'4')
    assert out
    line = r.recvline()
    assert b'You play whack-a-mole and win a platypus toy. What a day!' in line
    line = r.recvline()
    assert b'================================\n' == line

    # check second carnival
    out = r.sendlineafter(b'Save the game and quit.\n', b'1')
    assert out
    out = r.sendlineafter(b'Save the game and quit.\n', b'4')
    assert out
    line = r.recvline()
    assert b'You play whack-a-mole and win a platypus toy. What a day!' in line
    line = r.recvline()
    assert b'You go out of the carnival area' in line

    # check save and reload
    out = r.sendlineafter(b'Save the game and quit.\n', b'127')
    r.close()
    r = remote(ip, port)
    login(r, save)
    out = r.sendlineafter(b'Save the game and quit.\n', b'3')
    assert out
    line = r.recvline()
    assert b'You wrote' in line
    line = r.recvline()
    assert diary in line
    r.close()

def attempt_afford(ip, port):
    r = remote(ip, port)
    signup(r)
    age = 0
    accident = None
    count = 0
    while True:
        idx = check_event(r)
        # print(idx)
        if idx == 0:
            if accident is None or age < 8:
                out = r.sendlineafter(b'Save the game and quit.\n', b'1')
                assert out
            else:
                count += 1
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
        elif idx == 1:
            accident = age
        elif idx == 3:
            if count <= 0x10:
                r.close()
                return None
            line = r.recvline()
            assert b'To make her happy, you decide to construct a house on a nearby cliff.' in line
            line = r.recvline()
            assert b"But she doesn't seem happy..." in line
            r.close()
            return True
        else:
            pass
        age += 1
    r.close()
    return None

def check_anya(ip, port):
    # check can't afford
    r = remote(ip, port)
    signup(r)
    while True:
        idx = check_event(r)
        if idx == 3:
            break
        elif idx == 0:
            out = r.sendlineafter(b'Save the game and quit.\n', b'1')
            assert out
    r.recvline()
    assert b'afford' in r.recvline()
    r.close()

    # check afford
    res = None
    while res is None:
        res = attempt_afford(ip, port)

def check_dark(ip, port):
    # check fail
    r = remote(ip, port)
    signup(r)

    while True:
        idx = check_event(r)
        if idx == 0:
            out = r.sendlineafter(b'Save the game and quit.\n', b'1')
            assert out
        elif idx == 4:
            out = r.sendlineafter(b'What do you think? (y/n)\n', b'n')
            assert out
            line = r.recvline()
            assert b"You don't like the offer?" in line
            r.close()
            break
        else:
            pass
    r.close()

    # check attempt
    r = remote(ip, port)
    signup(r)

    while True:
        idx = check_event(r)
        if idx == 0:
            out = r.sendlineafter(b'Save the game and quit.\n', b'1')
            assert out
        elif idx == 4:
            out = r.sendlineafter(b'What do you think? (y/n)\n', b'y')
            assert out
            line = r.recvline()
            assert b"You can't afford my service." in line
            r.close()
            break
        else:
            pass
    r.close()

def _check_stock(ip, port):
    while True:
        r = remote(ip, port)
        save = signup(r)
        age = 0
        state = 0
        accident = None
        balance = None
        while accident is None:
            idx = check_event(r)
            if idx != 0:
                r.close()
                return None
            elif age < 8:
                out = r.sendlineafter(b'Save the game and quit.\n', b'1')
                assert out
            elif age < 18:
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
            else:
                if state == 0:
                    out = r.sendlineafter(b'Save the game and quit.\n', b'126')
                    assert out
                    r.recvuntil(b'Your balance : ')
                    balance = int(r.recvline())
                elif state == 1:
                    buy_stock(r, 1, 1)
                elif state == 2:
                    out = r.sendlineafter(b'Save the game and quit.\n', b'126')
                    assert out
                    r.recvuntil(b'Your balance : ')
                    tmp_balance = int(r.recvline())
                    assert tmp_balance == balance - 204
                elif state == 3:
                    sell_stock(r, 1, 1)
                elif state == 4:
                    out = r.sendlineafter(b'Save the game and quit.\n', b'126')
                    assert out
                    r.recvuntil(b'Your balance : ')
                    tmp_balance = int(r.recvline())
                    assert tmp_balance == balance
                    r.close()
                    return True
                else:
                    raise
                state += 1
            age += 1
        r.close()
        return None

def check_stock(ip, port):
    res = None
    while res is None:
        res = _check_stock(ip, port)
    assert res is True

def _check_transaction(ip, port):
    r = remote(ip, port)
    signup(r)

    # fastforward to accident
    age = 0
    accident = None
    while accident is None:
        idx = check_event(r)
        if idx == 1:
            accident = True
        else:
            out = r.sendlineafter(b'Save the game and quit.\n', b'1')
            assert out
        age += 1

    state = 0
    hype = None
    while True:
        idx = check_event(r)
        if idx == 2:
            hype = True
        elif idx == 0:
            if age < 8:
                out = r.sendlineafter(b'Save the game and quit.\n', b'1')
                assert out
            elif state == 0:
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
                state += 1
            elif state == 1:
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
                state += 1
            elif state == 2 and age < 18:
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
            elif state == 2 and age >= 18:
                buy_stock(r, 1, 1);
                state += 1
            elif state == 3 and hype is None:
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
            elif state == 3 and hype:
                out = r.sendlineafter(b'Save the game and quit.\n', b'7')
                assert out
                assert b"Yo, I'm DeepFuckingValue." in r.recvline()
                assert b"Welcome to the dark web!" in r.recvline()
                out = r.sendlineafter(b'How many shares do you want to send?\n', b'2')
                assert out
                assert b"You don't have enough shares, so you buy" in r.recvline()
                r.close()
                return True
            else:
                raise
        elif idx > 2:
            r.close()
            return None
        age += 1
    r.close()

def check_transaction(ip, port):
    res = None
    while res is None:
        res = _check_transaction(ip, port)

def _check_dream(ip, port):
    r = remote(ip, port)
    signup(r)

    # fastforward to accident
    age = 0
    accident = None
    hype = None
    anya = None
    count = 0
    stock = None
    balance = None
    dark = None
    while True:
        idx = check_event(r)
        if idx == 0:
            if age == 5:
                out = r.sendlineafter(b'Save the game and quit.\n', b'4')
                assert out
            elif accident is None or age < 8:
                out = r.sendlineafter(b'Save the game and quit.\n', b'1')
                assert out
            elif anya is None or count <= 0x11:
                count += 1
                out = r.sendlineafter(b'Save the game and quit.\n', b'5')
                assert out
            elif anya and stock is None:
                buy_stock(r, 4, 1)
                stock = True
            elif balance is None:
                out = r.sendlineafter(b'Save the game and quit.\n', b'126')
                assert out
                out = r.recvuntil(b'Your balance : ')
                assert out
                balance = int(r.recvline())
            else:
                out = r.sendlineafter(b'Save the game and quit.\n', b'1')
                assert out
        elif idx == 1:
            accident = age
        elif idx == 2:
            hype = age
        elif idx == 3:
            if count < 0x11:
                r.close()
                return None
            anya = age
        elif idx == 4:
            r.sendlineafter(b'What do you think? (y/n)', b'n')
            dark = age
            if dark == 99:
                r.close()
                return None
        elif idx == 5:
            r.recvline()
            assert b'But somehow you have the' in r.recvline()
            out = r.sendlineafter(b'Which memory do you want to chagne?', str(dark).encode())
            assert out
            out = r.sendlineafter(b'What do you think? (y/n)\n', b'y')
            assert out
            assert b"You can't afford my service." in r.recvline()
            out = r.sendlineafter(b'Which memory do you want to chagne?', b'99')
            assert out
            out = r.sendlineafter(b'127. Save the game and quit.', b'5')
            assert out
            out = r.recvuntil(b'Your balance : ')
            assert out
            new_balance = int(r.recvline())
            assert balance + 0x100 == new_balance

            r.close()
            return True
        else:
            raise
        age += 1
    r.close()
    return None

def check_dream(ip, port):
    res = None
    while res is None:
        res = _check_dream(ip, port)

def run_benign(ip, port):
    func_list = [check_new_user, check_events, check_minor_actions, check_anya, check_dark, check_stock, check_transaction, check_dream]
    for func in random.sample(func_list, 1):
        func(ip, port)

if __name__ == "__main__":
    import traceback

#    run_benign(sys.argv[1], int(sys.argv[2]))
    try:
        run_benign(sys.argv[1], int(sys.argv[2]))
        response = {
            "error": 0,
            "error_msg": "",
            "payload": {},
        }
    except Exception as e:
        response = { 
            "error": 1,
            "error_msg": str(e) + "\n" + traceback.format_exc(),
            "payload": {}
        }
    print(json.dumps(response))
