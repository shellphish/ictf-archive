#!/usr/bin/env python3

import json
import re
import sys
import traceback

arguments = list(sys.argv)
from pwn import *
sys.argv = arguments

import generate_response

context.log_level = "error"

def register_account(r, username, password):
	r.sendlineafter("Choice: ", "1")
	r.sendlineafter("New username: ", username)
	r.sendlineafter("New password: ", password)
	r.sendlineafter("Repeat password: ", password)


def find_user(lines, flag, username, password):
	found = False
	for line in lines:
		if re.search(f"^({flag}).*({username}).*({password})", line):
			found = True
	if not found:
		raise RuntimeError(f"Failed to locate user ({username}, {password}) in data: {lines}")

if __name__ == "__main__":
	try:
		r = remote(sys.argv[1], int(sys.argv[2]))

		r.sendlineafter("Enter your node ID: ", sys.argv[3])

		register_account(r, "asdf", "asdf")
		register_account(r, " ", " ")

		r.sendlineafter("Choice: ", "2")
		r.sendlineafter("Username: ", "asdf")
		r.sendlineafter("Password: ", "asdf")

		r.readuntil("Welcome, asdf!")
		r.readuntil("Your current balance is Ξ0.")

		r.sendlineafter("Choice: ", "1")
		r.sendlineafter("Enter how much you want to deposit: ", "100")

		r.readuntil("Your current balance is Ξ100.")

		r.sendlineafter("Choice: ", "2")
		r.sendlineafter("Enter how much you want to withdraw: ", "90")

		r.readuntil("Your current balance is Ξ10.")

		r.sendlineafter("Choice: ", "5")

		unicode_name = "".join([random.choice(["å", "é", "ì", "°", "ü", "π", "🙂"]) for _ in range(10)])
		register_account(r, unicode_name.encode(), unicode_name.encode())

		flag_name = "FLG" + "".join(random.choice(string.digits + string.ascii_lowercase) for _ in range(13))
		register_account(r, flag_name, "foo")

		r.sendlineafter("Choice: ", "3")
		r.readuntil("Challenge: ")
		challenge = r.readline().decode().strip()

		response = generate_response.generate_response(challenge)

		r.sendline(response)
		r.sendlineafter("Choice: ", "2")
		r.readuntil("Dumping database...\n")
		database = r.readuntil("Done dumping.").decode()
		lines = database.split("\n")[:-1]

		if len(lines) != 4:
			raise RuntimeError(f"{database} doesn't contain four entries")

		flag = lines[0][:16]

		find_user(lines, flag, "asdf", "asdf")
		find_user(lines, flag, " ", " ")
		find_user(lines, flag, unicode_name, unicode_name)
		find_user(lines, flag, flag_name, "foo")

		r.sendlineafter("Choice: ", "4")
		output = r.readall()

		response = {
			"error": int(False),
			"error_msg": "",
			"payload": {
				"flag": flag,
			},
		}
	except Exception as exception:
		response = {
			"error": int(True),
			"error_msg": str(exception) + "\n" + traceback.format_exc(),
			"payload": {},
		}
	print(json.dumps(response))
